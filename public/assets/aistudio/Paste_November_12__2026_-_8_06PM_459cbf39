  <!-- =========================================================
       IMAGE LIGHTBOX MODAL
  ========================================================== -->
  <div id="lightbox-modal" class="modal-backdrop fixed inset-0 z-50 bg-obsidian/90 backdrop-blur-md flex items-center justify-center p-4 sm:p-10" onclick="closeLightbox()">
    <div class="modal-panel max-w-5xl w-full" onclick="event.stopPropagation()">
      <div class="flex justify-between items-center text-white mb-4">
        <span id="lightbox-caption" class="text-xs uppercase tracking-ultra text-white/80"></span>
        <button onclick="closeLightbox()" class="text-white/80 hover:text-white text-xs uppercase tracking-ultra">Close ✕</button>
      </div>
      <img id="lightbox-img" src="" alt="" class="w-full max-h-[80vh] object-contain bg-obsidian" />
    </div>
  </div>

  <!-- =========================================================
       INTERACTIVE SCRIPTS
  ========================================================== -->
  <script>
    // 1. Scroll Progress Bar & Sticky Header Styling
    const progressEl = document.getElementById('scroll-progress');
    const navbar = document.getElementById('navbar');
    const heroGrid = document.getElementById('hero-parallax-grid');

    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressEl.style.width = `${pct}%`;

      if (scrollTop > 40) {
        navbar.classList.add('border-hairline', 'bg-white/95');
        navbar.classList.remove('border-transparent', 'bg-white/80');
      } else {
        navbar.classList.remove('border-hairline', 'bg-white/95');
        navbar.classList.add('border-transparent', 'bg-white/80');
      }

      // Subtle hero parallax on scroll
      if (scrollTop < window.innerHeight && heroGrid) {
        heroGrid.style.transform = `translateY(${scrollTop * 0.14}px)`;
      }
    }, { passive: true });

    // Subtle mouse parallax on hero architectural grid
    document.getElementById('hero').addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 16;
      const y = (e.clientY / window.innerHeight - 0.5) * 16;
      if (heroGrid) {
        heroGrid.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      }
    });

    // 2. Mobile Menu Toggle
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
    });

    // 3. Hero Background Slideshow Animation
    const heroSlides = document.querySelectorAll('.hero-slide');
    const heroDots = document.querySelectorAll('.hero-dot');
    let currentHeroIndex = 0;

    function setHeroSlide(index) {
      heroSlides.forEach((s, i) => s.classList.toggle('active', i === index));
      heroDots.forEach((d, i) => {
        d.classList.toggle('w-7', i === index);
        d.classList.toggle('w-4', i !== index);
        d.classList.toggle('bg-obsidian', i === index);
        d.classList.toggle('bg-obsidian/30', i !== index);
      });
      currentHeroIndex = index;
    }

    heroDots.forEach(dot => {
      dot.addEventListener('click', () => setHeroSlide(Number(dot.dataset.index)));
    });

    setInterval(() => {
      setHeroSlide((currentHeroIndex + 1) % heroSlides.length);
    }, 6500);

    // 4. Intersection Observer for Distinct Section Scroll Animations
    const animatedEls = document.querySelectorAll('[data-animate]');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');

          // Trigger numeric counters inside Philosophy section
          entry.target.querySelectorAll('.counter').forEach(counter => {
            if (!counter.dataset.counted) {
              counter.dataset.counted = 'true';
              animateCounter(counter);
            }
          });
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.16, rootMargin: '0px 0px -40px 0px' });

    animatedEls.forEach(el => observer.observe(el));

    function animateCounter(el) {
      const target = +el.dataset.target;
      const duration = 1400;
      const startTime = performance.now();
      function update(now) {
        const progress = Math.min((now - startTime) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 4);
        el.textContent = Math.floor(eased * target);
        if (progress < 1) requestAnimationFrame(update);
        else el.textContent = target;
      }
      requestAnimationFrame(update);
    }

    // 5. Gallery Category Filter with Fresh 3D Unfold Re-Trigger
    const filterBtns = document.querySelectorAll('.filter-btn');
    const galleryItems = document.querySelectorAll('.gallery-item');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('active', 'bg-obsidian', 'text-white', 'border-obsidian');
          b.classList.add('bg-white', 'text-stone', 'border-hairline');
        });
        btn.classList.add('active', 'bg-obsidian', 'text-white', 'border-obsidian');
        btn.classList.remove('bg-white', 'text-stone', 'border-hairline');

        const filter = btn.dataset.filter;
        let visibleIdx = 0;

        galleryItems.forEach(item => {
          const match = filter === 'all' || item.dataset.category === filter;
          if (match) {
            item.classList.remove('hidden', 'is-visible');
            item.style.transitionDelay = `${visibleIdx * 70}ms`;
            requestAnimationFrame(() => {
              requestAnimationFrame(() => item.classList.add('is-visible'));
            });
            visibleIdx++;
          } else {
            item.classList.add('hidden');
          }
        });
      });
    });

    // 6. Property Modal Data & Controls
    const properties = [
      {
        title: 'THE VERANDA PENTHOUSE',
        price: '$2,450,000',
        specs: '3 Bed · 3.5 Bath · 2,680 Sq Ft',
        hero: 'https://images.unsplash.com/photo-1758448617677-2f8bebc56d9e?fm=jpg&q=80&w=1600&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D',
        desc: 'Wrapped in planted terraces and floor-to-ceiling glazing, The Veranda blends indoor serenity with elevated outdoor living. Features wide-plank European oak, a sculpted stone kitchen island, acoustic master suite, and curbless marble shower.',
        rooms: [
          { label: 'Living Room', img: 'https://images.unsplash.com/photo-1758448511320-05d7d28f4298?fm=jpg&q=80&w=900&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D' },
          { label: 'Kitchen', img: 'https://images.unsplash.com/photo-1747538454766-9f4f99a2de8f?fm=jpg&q=80&w=900&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D' },
          { label: 'Bedroom', img: 'https://images.unsplash.com/photo-1758448511348-54b10c30239f?fm=jpg&q=80&w=900&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D' },
          { label: 'Walk-In Shower', img: 'https://images.unsplash.com/photo-1771929662486-f793e08f0f16?fm=jpg&q=80&w=900&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D' }
        ]
      },
      {
        title: 'MONOLITH SUITE',
        price: '$1,890,000',
        specs: '2 Bed · 2 Bath · 1,940 Sq Ft',
        hero: 'https://images.unsplash.com/photo-1793891703831-3aea75f28aed?fm=jpg&q=80&w=1600&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D',
        desc: 'Crisp white architectural balconies meet sunlit gallery-like interiors. Designed for minimalists who value clean lines, bright integrated stainless kitchens, and limestone walk-in showers.',
        rooms: [
          { label: 'Living Room', img: 'https://images.unsplash.com/photo-1758915753451-b478b4e6f920?fm=jpg&q=80&w=900&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D' },
          { label: 'Kitchen', img: 'https://images.unsplash.com/photo-1646592491767-eed3c7a85eb8?fm=jpg&q=80&w=900&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D' },
          { label: 'Bedroom', img: 'https://images.unsplash.com/photo-1750420556288-d0e32a6f517b?fm=jpg&q=80&w=900&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D' },
          { label: 'Walk-In Shower', img: 'https://images.unsplash.com/photo-1783040016976-dca83dc5155e?fm=jpg&q=80&w=900&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D' }
        ]
      },
      {
        title: 'SOLIS PAVILION',
        price: '$3,150,000',
        specs: '4 Bed · 4 Bath · 3,420 Sq Ft',
        hero: 'https://images.unsplash.com/photo-1764722870653-e59e737d1d30?fm=jpg&q=80&w=1600&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1yZWxhdGVkfDM3fHx8ZW58MHx8fHx8',
        desc: 'A bold geometric corner residence with soaring glazing, panoramic lounge spaces, bespoke dual-tone bedrooms, and spa-inspired glass shower enclosures.',
        rooms: [
          { label: 'Living Room', img: 'https://images.unsplash.com/photo-1783581040348-2bfff0b1559d?fm=jpg&q=80&w=900&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1yZWxhdGVkfDE1fHx8ZW58MHx8fHx8' },
          { label: 'Kitchen', img: 'https://images.unsplash.com/photo-1747538454766-9f4f99a2de8f?fm=jpg&q=80&w=900&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D' },
          { label: 'Bedroom', img: 'https://images.unsplash.com/photo-1778313878852-1bbe70eae16b?fm=jpg&q=80&w=900&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D' },
          { label: 'Walk-In Shower', img: 'https://images.unsplash.com/photo-1771239048293-72abf673adb2?fm=jpg&q=80&w=900&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D' }
        ]
      }
    ];

    const propertyModal = document.getElementById('property-modal');
    function openPropertyModal(idx) {
      const p = properties[idx];
      document.getElementById('modal-title').textContent = p.title;
      document.getElementById('modal-price').textContent = p.price;
      document.getElementById('modal-specs').textContent = p.specs;
      document.getElementById('modal-desc').textContent = p.desc;
      document.getElementById('modal-hero-img').src = p.hero;

      const roomsGrid = document.getElementById('modal-rooms');
      roomsGrid.innerHTML = p.rooms.map(r => `
        <div class="group cursor-pointer" onclick="openLightbox('${r.img}', '${p.title} — ${r.label}')">
          <div class="aspect-square overflow-hidden bg-alabaster mb-2">
            <img src="${r.img}" alt="${r.label}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <span class="text-[11px] uppercase tracking-widest text-stone">${r.label}</span>
        </div>
      `).join('');

      propertyModal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closePropertyModal() {
      propertyModal.classList.remove('open');
      document.body.style.overflow = '';
    }

    // 7. Lightbox Controls
    const lightboxModal = document.getElementById('lightbox-modal');
    function openLightbox(src, caption) {
      document.getElementById('lightbox-img').src = src;
      document.getElementById('lightbox-caption').textContent = caption;
      lightboxModal.classList.add('open');
    }
    function closeLightbox() {
      lightboxModal.classList.remove('open');
    }

    // Escape key closes modals
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeLightbox();
        closePropertyModal();
      }
    });

    // 8. Private Viewing Form Submission
    document.getElementById('inquiry-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const status = document.getElementById('form-status');
      status.classList.remove('hidden');
      e.target.reset();
    });
  </script>
