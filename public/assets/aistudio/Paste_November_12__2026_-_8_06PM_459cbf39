      <div class="pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-white/40">
        <span>© 2026 Atelier Kova Realty. All rights reserved.</span>
        <span>Architecture · Light · Proportion</span>
      </div>
    </div>
  </footer>

  <!-- =========================================================
       PROPERTY DETAIL MODAL
  ========================================================== -->
  <div id="property-modal" class="modal-backdrop fixed inset-0 z-50 bg-obsidian/65 backdrop-blur-sm flex items-center justify-center p-4 sm:p-8">
    <div class="modal-panel bg-white max-w-4xl w-full max-h-[90vh] overflow-y-auto border border-hairline">
      <div class="flex items-center justify-between px-6 sm:px-10 py-6 border-b border-hairline sticky top-0 bg-white z-10">
        <div>
          <span class="text-[10px] uppercase tracking-ultra text-stone block">Residence Dossier</span>
          <h3 id="modal-title" class="font-display font-bold text-2xl tracking-tight"></h3>
        </div>
        <button onclick="closePropertyModal()" class="p-2 hover:bg-alabaster transition-colors" aria-label="Close modal">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="p-6 sm:p-10 space-y-8">
        <div class="aspect-[16/9] overflow-hidden bg-alabaster">
          <img id="modal-hero-img" src="" alt="" class="w-full h-full object-cover" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
          <div class="md:col-span-2">
            <p id="modal-desc" class="text-sm sm:text-base font-light text-stone leading-relaxed"></p>
          </div>
          <div class="bg-alabaster p-5 border border-hairline space-y-3 text-xs uppercase tracking-widest">
            <div class="flex justify-between"><span>Price</span><span id="modal-price" class="font-semibold text-obsidian"></span></div>
            <div class="flex justify-between"><span>Layout</span><span id="modal-specs" class="font-semibold text-obsidian"></span></div>
          </div>
        </div>

        <div>
          <span class="text-[11px] uppercase tracking-ultra text-stone block mb-4">Included Interior Rooms (Living · Kitchen · Bedroom · Shower)</span>
          <div id="modal-rooms" class="grid grid-cols-2 sm:grid-cols-4 gap-4"></div>
        </div>

        <div class="pt-4 border-t border-hairline flex justify-end">
