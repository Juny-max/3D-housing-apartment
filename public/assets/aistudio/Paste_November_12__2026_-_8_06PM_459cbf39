  <!-- Bold & Clean Editorial Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Syne:wght@600;700;800&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['Syne', 'sans-serif'],
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            obsidian: '#0D0D0C',
            stone: '#6B6B66',
            paper: '#FFFFFF',
            alabaster: '#F8F8F6',
            hairline: '#E8E8E4',
            sand: '#A8947A',
          },
          letterSpacing: {
            ultra: '0.22em',
          }
        }
      }
    }
  </script>

  <style>
    :root {
      --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in-out-quint: cubic-bezier(0.83, 0, 0.17, 1);
    }

    body {
      background-color: #FFFFFF;
      color: #0D0D0C;
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* -------------------------------------------
       HERO BACKGROUND ANIMATION (Ken Burns + Drift)
    -------------------------------------------- */
    @keyframes kenBurnsSlow {
      0% {
        transform: scale(1.0) translate3d(0%, 0%, 0);
      }
      50% {
        transform: scale(1.09) translate3d(-1.5%, -1%, 0);
      }
      100% {
        transform: scale(1.0) translate3d(0%, 0%, 0);
      }
    }

    @keyframes subtleSweep {
      0% { transform: translateX(-100%) skewX(-18deg); opacity: 0; }
      40% { opacity: 0.22; }
      100% { transform: translateX(220%) skewX(-18deg); opacity: 0; }
    }

    @keyframes heroTextMask {
      0% {
        opacity: 0;
        transform: translateY(115%);
      }
      100% {
        opacity: 1;
        transform: translateY(0%);
      }
    }

    @keyframes lineGrow {
      0% { transform: scaleX(0); }
      100% { transform: scaleX(1); }
    }

    .hero-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 1.8s var(--ease-out-expo);
      will-change: opacity, transform;
    }

    .hero-slide.active {
      opacity: 1;
    }

    .hero-slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      animation: kenBurnsSlow 24s ease-in-out infinite;
      will-change: transform;
    }

    .hero-light-sweep {
      position: absolute;
      inset: 0;
      width: 45%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.28), transparent);
      animation: subtleSweep 11s ease-in-out infinite;
      pointer-events: none;
    }

    .hero-reveal-line {
      overflow: hidden;
      display: block;
    }

    .hero-reveal-inner {
      display: inline-block;
      animation: heroTextMask 1.15s var(--ease-out-expo) both;
    }

    /* -------------------------------------------
       SCROLL PROGRESS BAR
    -------------------------------------------- */
    #scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 2px;
      width: 0%;
      background: #0D0D0C;
      z-index: 60;
      transition: width 0.08s linear;
    }

    /* -------------------------------------------
       DISTINCT SECTION SCROLL ANIMATIONS
    -------------------------------------------- */

    /* 1. SECTION 2: VERTICAL STAGGERED LIFT */
    .anim-lift {
      opacity: 0;
      transform: translateY(72px);
      transition: opacity 1s var(--ease-out-expo), transform 1.15s var(--ease-out-expo);
      will-change: opacity, transform;
    }
    .anim-lift.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    .anim-lift .img-settle {
      transform: scale(1.09);
      transition: transform 1.6s var(--ease-out-expo);
    }
    .anim-lift.is-visible .img-settle {
      transform: scale(1);
    }

    /* 2. SECTION 3: EDITORIAL CLIP-PATH CURTAIN WIPE */
    .anim-curtain-left {
      clip-path: inset(0 100% 0 0);
      opacity: 0.4;
      transition: clip-path 1.25s var(--ease-in-out-quint), opacity 1s ease;
      will-change: clip-path, opacity;
    }
    .anim-curtain-left.is-visible {
      clip-path: inset(0 0% 0 0);
      opacity: 1;
    }

    .anim-curtain-right {
      clip-path: inset(0 0 0 100%);
      opacity: 0.4;
      transition: clip-path 1.25s var(--ease-in-out-quint), opacity 1s ease;
      will-change: clip-path, opacity;
    }
    .anim-curtain-right.is-visible {
      clip-path: inset(0 0 0 0%);
      opacity: 1;
    }

    .anim-slide-counter {
      opacity: 0;
      transform: translateX(36px);
      transition: opacity 1s var(--ease-out-expo) 0.2s, transform 1s var(--ease-out-expo) 0.2s;
    }
    .anim-slide-counter.from-left {
      transform: translateX(-36px);
    }
    .anim-slide-counter.is-visible {
      opacity: 1;
      transform: translateX(0);
    }

    /* 3. SECTION 4: FOCUS BLUR-TO-SHARP ZOOM */
    .anim-focus-zoom {
      opacity: 0;
      filter: blur(14px);
      transform: scale(0.92);
      transition: opacity 1.1s var(--ease-out-expo), filter 1.2s var(--ease-out-expo), transform 1.2s var(--ease-out-expo);
      will-change: opacity, filter, transform;
    }
    .anim-focus-zoom.is-visible {
      opacity: 1;
      filter: blur(0px);
      transform: scale(1);
    }

    /* 4. SECTION 5: 3D PERSPECTIVE UNFOLD */
    .perspective-wrap {
      perspective: 1400px;
    }
    .anim-unfold {
      opacity: 0;
      transform: rotateX(18deg) translateY(48px) scale(0.96);
      transform-origin: center top;
      transition: opacity 0.95s var(--ease-out-expo), transform 1.15s var(--ease-out-expo);
      will-change: opacity, transform;
    }
    .anim-unfold.is-visible {
      opacity: 1;
      transform: rotateX(0deg) translateY(0) scale(1);
    }

    /* 5. SECTION 6: SPLIT HORIZONTAL CONVERGE */
    .anim-split-left {
      opacity: 0;
      transform: translateX(-56px);
      transition: opacity 1s var(--ease-out-expo), transform 1.1s var(--ease-out-expo);
    }
    .anim-split-right {
      opacity: 0;
      transform: translateX(56px);
      transition: opacity 1s var(--ease-out-expo) 0.12s, transform 1.1s var(--ease-out-expo) 0.12s;
    }
    .anim-split-left.is-visible,
    .anim-split-right.is-visible {
      opacity: 1;
      transform: translateX(0);
    }

    /* 6. FOOTER: UPWARD ARCHITECTURAL UNMASK */
    .anim-unmask-up {
      opacity: 0;
      clip-path: inset(100% 0 0 0);
      transform: translateY(28px);
      transition: clip-path 1.1s var(--ease-out-expo), opacity 0.9s ease, transform 1.1s var(--ease-out-expo);
    }
    .anim-unmask-up.is-visible {
      opacity: 1;
      clip-path: inset(0% 0 0 0);
      transform: translateY(0);
    }

    /* Minimal Hover Polish */
    .image-hover-zoom img {
      transition: transform 0.9s var(--ease-out-expo);
    }
    .image-hover-zoom:hover img {
      transform: scale(1.045);
    }

    /* Modal transitions */
    .modal-backdrop {
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.35s ease;
    }
    .modal-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }
    .modal-panel {
      transform: translateY(24px) scale(0.98);
      transition: transform 0.45s var(--ease-out-expo);
    }
    .modal-backdrop.open .modal-panel {
      transform: translateY(0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-slide img, .hero-light-sweep { animation: none !important; }
      .anim-lift, .anim-curtain-left, .anim-curtain-right, .anim-slide-counter,
      .anim-focus-zoom, .anim-unfold, .anim-split-left, .anim-split-right, .anim-unmask-up {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
        clip-path: none !important;
      }
    }
  </style>
</head>
