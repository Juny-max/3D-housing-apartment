          <p class="text-xs uppercase tracking-ultra text-white/50">Minimalist Modern Real Estate</p>
        </div>
        <div class="flex flex-wrap gap-8 text-xs uppercase tracking-ultra text-white/70">
          <a href="#residences" class="hover:text-white transition-colors">Residences</a>
          <a href="#interiors" class="hover:text-white transition-colors">Spaces</a>
          <a href="#philosophy" class="hover:text-white transition-colors">Ethos</a>
          <a href="#gallery" class="hover:text-white transition-colors">Gallery</a>
